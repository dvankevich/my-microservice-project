pipeline {
  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-kaniko-agent
spec:
  serviceAccountName: jenkins-sa
  affinity:
    podAntiAffinity:
      preferredDuringSchedulingIgnoredDuringExecution:
        - weight: 100
          podAffinityTerm:
            labelSelector:
              matchExpressions:
                - key: statefulset.kubernetes.io/pod-name
                  operator: In
                  values:
                    - jenkins-0
            topologyKey: kubernetes.io/hostname
  containers:
    - name: kaniko
      image: gcr.io/kaniko-project/executor:v1.23.2-debug
      imagePullPolicy: IfNotPresent
      command:
        - sleep
      args:
        - 99d
      resources:
        requests:
          cpu: "250m"
          memory: "600Mi"
        limits:
          cpu: "1000m"
          memory: "1450Mi"
"""
    }
  }

  stages {
    stage('Verify Environment') {
      steps {
        script {
          if (!env.ECR_REPO_URL) {
            error("Змінна середовища ECR_REPO_URL не задана в налаштуваннях Jenkins (JCasC)!")
          }
          echo "Target ECR Repository: ${env.ECR_REPO_URL}"
          echo "Image Tags: latest, ${env.BUILD_NUMBER}"
        }
      }
    }

    stage('Build & Push Docker Image to ECR') {
      steps {
        container('kaniko') {
          sh '''
            /kaniko/executor \
              --context="${WORKSPACE}/lesson-4/mysite" \
              --dockerfile="${WORKSPACE}/lesson-4/mysite/Dockerfile" \
              --destination="${ECR_REPO_URL}:latest" \
              --destination="${ECR_REPO_URL}:${BUILD_NUMBER}" \
              --snapshot-mode=redo \
              --use-new-run \
              --compressed-caching=false
          '''
        }
      }
    }
  }
}
