          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"wagtail\", pod=~\"django-app.*\", container!=\"\", container!=\"POD\"}[5m]))",
          "legendFormat": "CPU Cores",
          "refId": "A"
