pipeline {
  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-kaniko-agent
spec:
  serviceAccountName: jenkins-sa
  affinity:
    podAntiAffinity:
      preferredDuringSchedulingIgnoredDuringExecution:
        - weight: 100
          podAffinityTerm:
            labelSelector:
              matchExpressions:
                - key: statefulset.kubernetes.io/pod-name
                  operator: In
                  values:
                    - jenkins-0
            topologyKey: kubernetes.io/hostname
  containers:
    - name: jnlp
      resources:
        requests:
          cpu: "100m"
          memory: "128Mi"
        limits:
          cpu: "300m"
          memory: "256Mi"
    - name: kaniko
      image: gcr.io/kaniko-project/executor:v1.23.2-debug
      imagePullPolicy: IfNotPresent
      command:
        - sleep
      args:
        - 99d
      resources:
        requests:
          cpu: "200m"
          memory: "350Mi"
        limits:
          cpu: "1000m"
          memory: "1450Mi"
"""
    }
  }

  stages {
    stage('Verify Environment') {
      steps {
        script {
          def commitSubject = sh(script: "git log -1 --pretty=%s", returnStdout: true).trim()
          def isManualBuild = currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause').size() > 0

          if (!isManualBuild && commitSubject.contains('[skip ci]')) {
            echo "Коміт містить [skip ci], пропускаємо збірку."
            currentBuild.result = 'NOT_BUILT'
            return
          }
          if (!env.ECR_REPO_URL) {
            error("Змінна середовища ECR_REPO_URL не задана в налаштуваннях Jenkins (JCasC)!")
          }
          echo "Target ECR Repository: ${env.ECR_REPO_URL}"
          echo "Image Tags: latest, ${env.BUILD_NUMBER}"
        }
      }
    }

    stage('Build & Push Docker Image to ECR') {
      when {
        expression { currentBuild.result != 'NOT_BUILT' }
      }
      steps {
        container('kaniko') {
          sh '''
            /kaniko/executor \
              --context="${WORKSPACE}/Django" \
              --dockerfile="${WORKSPACE}/Django/Dockerfile" \
              --destination="${ECR_REPO_URL}:latest" \
              --destination="${ECR_REPO_URL}:${BUILD_NUMBER}" \
              --snapshot-mode=redo \
              --use-new-run \
              --compressed-caching=false
          '''
        }
      }
    }
  }
}
