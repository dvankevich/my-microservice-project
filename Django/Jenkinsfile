pipeline {
  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-kaniko-agent
spec:
  serviceAccountName: jenkins-sa
  affinity:
    podAntiAffinity:
      preferredDuringSchedulingIgnoredDuringExecution:
        - weight: 100
          podAffinityTerm:
            labelSelector:
              matchExpressions:
                - key: statefulset.kubernetes.io/pod-name
                  operator: In
                  values:
                    - jenkins-0
            topologyKey: kubernetes.io/hostname
  containers:
    - name: jnlp
      resources:
        requests:
          cpu: "100m"
          memory: "128Mi"
        limits:
          cpu: "300m"
          memory: "256Mi"
    - name: sast
      image: python:3.13-slim-trixie
      imagePullPolicy: IfNotPresent
      command:
        - sleep
      args:
        - 99d
      resources:
        requests:
          cpu: "100m"
          memory: "256Mi"
        limits:
          cpu: "500m"
          memory: "768Mi"
    - name: sec-scan
      image: aquasec/trivy:0.58.2
      imagePullPolicy: IfNotPresent
      command:
        - sleep
      args:
        - 99d
      resources:
        requests:
          cpu: "100m"
          memory: "192Mi"
        limits:
          cpu: "500m"
          memory: "512Mi"
    - name: kaniko
      image: gcr.io/kaniko-project/executor:v1.23.2-debug
      imagePullPolicy: IfNotPresent
      command:
        - sleep
      args:
        - 99d
      resources:
        requests:
          cpu: "200m"
          memory: "350Mi"
        limits:
          cpu: "1000m"
          memory: "1450Mi"
"""
    }
  }

  stages {
    stage('Verify Environment') {
      steps {
        script {
          def actualBranch = (env.GIT_BRANCH ?: '').trim()
          if (!actualBranch) {
            actualBranch = sh(script: 'git rev-parse --abbrev-ref @{upstream} 2>/dev/null || git name-rev --name-only HEAD', returnStdout: true).trim()
          }
          def normalizedBranch = actualBranch
            .replaceFirst(/^refs\/heads\//, '')
            .replaceFirst(/^refs\/remotes\//, '')
            .replaceFirst(/^remotes\//, '')
            .replaceFirst(/^origin\//, '')
            .replaceFirst(/~\d+$/, '')

          def tagPrefix
          if (normalizedBranch == 'main') {
            tagPrefix = ''
          } else if (normalizedBranch == 'dev' || normalizedBranch == 'staging') {
            tagPrefix = normalizedBranch
          } else {
            error("Гілка '${actualBranch}' не підтримується. Очікується main, dev або staging.")
          }

          def expectedBranch = ''
          if (env.JOB_NAME == 'django-wagtail-ci') {
            expectedBranch = 'main'
          } else if (env.JOB_NAME == 'django-wagtail-ci-dev') {
            expectedBranch = 'dev'
          } else if (env.JOB_NAME == 'django-wagtail-ci-staging') {
            expectedBranch = 'staging'
          }
          if (expectedBranch && expectedBranch != normalizedBranch) {
            error("Job ${env.JOB_NAME} зібрав гілку '${actualBranch}', очікується ${expectedBranch}.")
          }

          def commitSubject = sh(script: "git log -1 --pretty=%s", returnStdout: true).trim()
          def isManualBuild = currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause').size() > 0

          if (!isManualBuild && commitSubject.contains('[skip ci]')) {
            echo "Коміт містить [skip ci], пропускаємо збірку."
            currentBuild.result = 'NOT_BUILT'
            return
          }
          if (!env.ECR_REPO_URL) {
            error("Змінна середовища ECR_REPO_URL не задана в налаштуваннях Jenkins (JCasC)!")
          }

          def imageTag = tagPrefix ? "${tagPrefix}-${env.BUILD_NUMBER}" : env.BUILD_NUMBER
          env.IMAGE_TAG = imageTag
          env.PUSH_LATEST = tagPrefix ? 'false' : 'true'

          echo "Target ECR Repository: ${env.ECR_REPO_URL}"
          echo "Tracked branch: ${normalizedBranch}"
          echo "Image tag: ${imageTag}"
        }
      }
    }

    stage('SAST (Bandit & Semgrep)') {
      when {
        expression { currentBuild.result != 'NOT_BUILT' }
      }
      steps {
        container('sast') {
          sh '''
            set -eu
            pip install --quiet --no-cache-dir bandit semgrep

            echo "=== Running Bandit (Python AST security check) ==="
            bandit -r Django/ -c Django/pyproject.toml -f json -o bandit-report.json || true
            bandit -r Django/ -c Django/pyproject.toml --severity-level medium --confidence-level medium

            echo "=== Running Semgrep (Django / Wagtail / Dockerfile rules) ==="
            semgrep scan \
              --config p/python \
              --config p/django \
              --config p/dockerfile \
              --exclude "Django/mysite/settings/dev.py" \
              --severity ERROR \
              --error \
              --json-output=semgrep-report.json \
              Django/
          '''
        }
      }
      post {
        always {
          archiveArtifacts artifacts: 'bandit-report.json,semgrep-report.json', allowEmptyArchive: true
        }
      }
    }

    stage('Secret & IaC Scan (Gitleaks & Trivy)') {
      when {
        expression { currentBuild.result != 'NOT_BUILT' }
      }
      steps {
        container('sec-scan') {
          sh '''
            set -eu
            if ! command -v gitleaks >/dev/null 2>&1; then
              apk add --no-cache curl tar >/dev/null
              curl -sSfL https://github.com/gitleaks/gitleaks/releases/download/v8.21.2/gitleaks_8.21.2_linux_x64.tar.gz \
                | tar -xz -C /usr/local/bin gitleaks
            fi

            gitleaks_cfg=""
            if [ -f .gitleaks.toml ]; then
              gitleaks_cfg="--config=.gitleaks.toml"
            fi

            trivy_ignore=""
            if [ -f .trivyignore ]; then
              trivy_ignore="--ignorefile=.trivyignore"
            fi

            echo "=== 1. Scanning Git history for leaked secrets (Gitleaks) ==="
            # shellcheck disable=SC2086
            gitleaks detect \
              --source . \
              ${gitleaks_cfg} \
              --report-format json \
              --report-path gitleaks-report.json \
              --verbose

            echo "=== 2. Scanning Helm & Terraform manifests (Trivy IaC) ==="
            # shellcheck disable=SC2086
            trivy config \
              ${trivy_ignore} \
              --severity HIGH,CRITICAL \
              --format json \
              --output trivy-iac-report.json \
              charts/ modules/

            # shellcheck disable=SC2086
            trivy config \
              ${trivy_ignore} \
              --severity CRITICAL \
              --exit-code 1 \
              charts/ modules/
          '''
        }
      }
      post {
        always {
          archiveArtifacts artifacts: 'gitleaks-report.json,trivy-iac-report.json', allowEmptyArchive: true
        }
      }
    }

    stage('Build & Push Docker Image to ECR') {
      when {
        expression { currentBuild.result != 'NOT_BUILT' }
      }
      steps {
        container('kaniko') {
          sh '''
            set -eu
            if [ -z "${IMAGE_TAG}" ]; then
              echo "IMAGE_TAG is empty" >&2
              exit 1
            fi
            destinations="--destination=${ECR_REPO_URL}:${IMAGE_TAG}"
            if [ "${PUSH_LATEST}" = "true" ]; then
              destinations="${destinations} --destination=${ECR_REPO_URL}:latest"
            fi
            # shellcheck disable=SC2086
            /kaniko/executor \
              --context="${WORKSPACE}/Django" \
              --dockerfile="${WORKSPACE}/Django/Dockerfile" \
              ${destinations} \
              --snapshot-mode=redo \
              --use-new-run \
              --compressed-caching=false \
              --log-format=text
          '''
        }
      }
    }
  }
}
