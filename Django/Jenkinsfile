pipeline {
  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-kaniko-agent
spec:
  serviceAccountName: jenkins-sa
  affinity:
    podAntiAffinity:
      preferredDuringSchedulingIgnoredDuringExecution:
        - weight: 100
          podAffinityTerm:
            labelSelector:
              matchExpressions:
                - key: statefulset.kubernetes.io/pod-name
                  operator: In
                  values:
                    - jenkins-0
            topologyKey: kubernetes.io/hostname
  containers:
    - name: jnlp
      resources:
        requests:
          cpu: "100m"
          memory: "128Mi"
        limits:
          cpu: "300m"
          memory: "256Mi"
    - name: kaniko
      image: gcr.io/kaniko-project/executor:v1.23.2-debug
      imagePullPolicy: IfNotPresent
      command:
        - sleep
      args:
        - 99d
      resources:
        requests:
          cpu: "200m"
          memory: "350Mi"
        limits:
          cpu: "1000m"
          memory: "1450Mi"
    - name: git
      image: alpine/git:latest
      imagePullPolicy: IfNotPresent
      command:
        - sleep
      args:
        - 99d
      resources:
        requests:
          cpu: "50m"
          memory: "32Mi"
        limits:
          cpu: "200m"
          memory: "128Mi"
"""
    }
  }

  environment {
    COMMIT_EMAIL = "jenkins@dvankevich.pp.ua"
    COMMIT_NAME  = "Jenkins CI"
  }

  stages {
    stage('Verify Environment') {
      steps {
        script {
          def lastCommit = sh(script: "git log -1 --pretty=%B", returnStdout: true).trim()
          if (lastCommit.contains('[skip ci]')) {
            echo "Коміт містить [skip ci], пропускаємо повторну збірку."
            currentBuild.result = 'NOT_BUILT'
            return
          }
          if (!env.ECR_REPO_URL) {
            error("Змінна середовища ECR_REPO_URL не задана в налаштуваннях Jenkins (JCasC)!")
          }
          echo "Target ECR Repository: ${env.ECR_REPO_URL}"
          echo "Image Tags: latest, ${env.BUILD_NUMBER}"
        }
      }
    }

    stage('Build & Push Docker Image to ECR') {
      when {
        expression { currentBuild.result != 'NOT_BUILT' }
      }
      steps {
        container('kaniko') {
          sh '''
            /kaniko/executor \
              --context="${WORKSPACE}/Django" \
              --dockerfile="${WORKSPACE}/Django/Dockerfile" \
              --destination="${ECR_REPO_URL}:latest" \
              --destination="${ECR_REPO_URL}:${BUILD_NUMBER}" \
              --snapshot-mode=redo \
              --use-new-run \
              --compressed-caching=false
          '''
        }
      }
    }

    stage('Update Chart Tag in Git') {
      when {
        expression { currentBuild.result != 'NOT_BUILT' }
      }
      steps {
        container('git') {
          withCredentials([usernamePassword(credentialsId: 'github-token', usernameVariable: 'GIT_USERNAME', passwordVariable: 'GIT_PAT')]) {
            sh '''
              rm -rf /tmp/repo
              git clone https://${GIT_USERNAME}:${GIT_PAT}@github.com/dvankevich/my-microservice-project.git /tmp/repo
              cd /tmp/repo

              sed -i 's|^  tag: .*|  tag: "'"${BUILD_NUMBER}"'"|' charts/django-app/values.yaml

              git config user.email "${COMMIT_EMAIL}"
              git config user.name "${COMMIT_NAME}"

              git add charts/django-app/values.yaml
              git commit -m "chore(cd): update django-app image tag to ${BUILD_NUMBER} [skip ci]"
              git push origin main
            '''
          }
        }
      }
    }
  }
}
